{
  "name": "dsh-notify-toast",
  "version": "1.0.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/lilanrong/chajian.git"
  },
  "homepage": "https://github.com/lilanrong/chajian#readme",
  "description": "Windows 右下角通知：任务完成、需要你选择、需要批准时弹出系统提示（类似 Codex 的提醒）。",
  "type": "module",
  "main": "index.js",
  "icon": "icon.png",
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/",
    "icon.png",
    "icon.ico",
    "README.md"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.png",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": "*"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "notification",
    "toast",
    "windows"
  ],
  "license": "MIT"
}
